#ifndef LIGHT_INC
#define LIGHT_INC 1

#define DirectionalLightType 0
#define PointLightType 1
#define SpotLightType 2

struct Light {
    uint    type;
    vec3    position;
    vec3    direction;
    vec3    color;
    float   intensity;
    float   range;
    float   falloff;
    float   spotAngle;
};

#endif
