#define TEX_SET 4
#define MAT_SET 3
#define VERTEX_SET 2
#define LIGHT_SET 1

#include "LightDef.glslh"

layout(scalar, set=0, binding=0) uniform GlobalUBO {
    mat4    uViewProj;
    mat4    uView;
    mat4    uProj;
    vec3    uEyePos;
    float   uAmbientLight;
    uint    tBRDFLut;
    uint    tIrradianceMap;
    uint    tPrefilteredMap;
    bool    uUseSunLight;
};

layout(scalar, set = LIGHT_SET, binding = 0) buffer LightBuffer
{
    uint lightCount;
    Light lights[];
};
